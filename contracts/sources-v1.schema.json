{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dounai.local/contracts/sources-v1.schema.json",
  "title": "Dounai source registry v1",
  "description": "catalog 源注册表，落在 state/sources.json。每个启用源绑定一把 catalog 签名公钥与完整指纹；验 catalog 只查这张表，不读 trust.json，也不采信 catalog 自述的 pubkey。每源独立记 sequence / expires 水位。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "catalog_pubkey 原始 32 字节的 SHA-256，小写十六进制。必须与启动时重算的指纹一致。"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "base_url", "catalog_pubkey", "catalog_fingerprint",
        "host_suffixes", "enabled", "deletable", "auto_update"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "kind": { "enum": ["official", "community"] },
        "base_url": {
          "type": "string",
          "pattern": "^https://[a-z0-9.-]+(/[^\\s]*)?$",
          "description": "catalog.json 所在的目录基址，不含尾斜杠。"
        },
        "catalog_pubkey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "description": "Ed25519 公钥原始 32 字节的 base64。由用户带外导入，启动器用它验该源的 catalog。"
        },
        "catalog_fingerprint": { "$ref": "#/$defs/fingerprint" },
        "host_suffixes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$",
            "description": "该源 catalog 与包下载允许的域名后缀。必须至少两段，不得填 com/net 这类公共后缀。"
          },
          "description": "添加源时从 base_url 的 host 派生，用户确认后才落盘；离线时 allowlist 就是所有启用源后缀的并集。"
        },
        "enabled": { "type": "boolean" },
        "deletable": { "type": "boolean", "description": "内置官方源固定 false，可禁用不可删除。" },
        "auto_update": { "type": "boolean", "description": "从该源安装的实例是否可自动更新。社区源固定 false。" },
        "group": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$",
          "description": "共享新鲜度水位的组。官方主源与镜像写同一个组，表示同一份 catalog 的两个副本；缺省即源 id。"
        },
        "sequence": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "该源（或组）已见过的最大 catalog 序号，跨源不比较。"
        },
        "expires": {
          "type": ["string", "null"],
          "description": "该源（或组）已见过的最大 catalog 过期时间。"
        },
        "priority": { "type": "integer", "minimum": 1 },
        "added_at": { "type": "string", "format": "date-time" },
        "revoked_at": {
          "type": ["string", "null"],
          "description": "撤销该源 catalog 公钥的时间；非空时 enabled 必须为 false。"
        },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "official" } }, "required": ["kind"] },
          "then": {
            "properties": { "deletable": { "const": false } },
            "description": "内置官方源可禁用、不可删除。"
          }
        },
        {
          "if": { "properties": { "kind": { "const": "community" } }, "required": ["kind"] },
          "then": {
            "properties": { "auto_update": { "const": false } },
            "description": "社区源只提示有新版，从不自动装。"
          }
        },
        {
          "if": { "properties": { "revoked_at": { "type": "string" } }, "required": ["revoked_at"] },
          "then": { "properties": { "enabled": { "const": false } } },
          "description": "撤销公钥立即停用该源。"
        }
      ]
    }
  }
}
