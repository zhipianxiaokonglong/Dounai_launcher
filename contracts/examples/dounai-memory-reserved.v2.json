{
  "schema_version": 2,
  "module_id": "dounai/dounai-memory-reserved",
  "name": "本地记忆扩展插件（Reserved · 默认禁用）",
  "version": "0.1.0",
  "variant": "stable",
  "role": "auxiliary",
  "category": "reserved",
  "publisher": { "id": "dounai", "name": "Dounai", "url": "" },
  "requires": { "launcher": ">=1.0.0", "roles_version": "1.0.0" },
  "depends_on": [],
  "runtime": {
    "python": ">=3.11,<3.14",
    "venv": "{instance_venv}",
    "deps": { "kind": "pyproject", "path": "pyproject.toml", "extras": [] }
  },
  "entry": {
    "command": "{venv_python} -m dounai_memory_reserved",
    "working_dir": "{module_dir}",
    "env": { "DOUNAI_MEMORY_ENABLED": "0", "DOUNAI_MEMORY_PORT": "{port}" },
    "health": null
  },
  "ports": [],
  "permissions": {
    "network": [],
    "filesystem": ["{data_dir}/memory"],
    "devices": []
  },
  "auxiliary_kind": "memory",
  "files": {},
  "signature": null
}
