{
  "module_id": "moodvoice",
  "name": "输出表达层 · MoodVoice",
  "version": "1.0.0",
  "category": "optional",
  "entry": {
    "type": "command",
    "command": "{module_dir}/.venv/Scripts/python.exe -m emotional_tts serve --port 8103",
    "working_dir": "",
    "env": {
      "EMOTION_TTS_PORT": "8103",
      "EMOTION_TTS_DATA_DIR": "{data_dir}/moodvoice",
      "EMOTION_TTS_ROOT": "{repo}/output"
    },
    "health": {
      "url": "http://127.0.0.1:8103/api/health",
      "timeout_ms": 3000
    }
  },
  "compat": {
    "app_version": ">=0.1.0"
  },
  "dependencies": [
    {
      "name": "Python",
      "version": ">=3.11",
      "type": "runtime"
    },
    {
      "name": "fastapi",
      "version": ">=0.115",
      "type": "library"
    },
    {
      "name": "uvicorn",
      "version": ">=0.32",
      "type": "library"
    },
    {
      "name": "edge-tts",
      "version": ">=7,<8",
      "type": "library"
    }
  ],
  "model_packs": [
    {
      "id": "gpt-sovits",
      "name": "GPT-SoVITS（本地 TTS）",
      "size_mb": 3584,
      "hardware_req": {
        "gpu": "required",
        "ram_mb": 8192,
        "disk_mb": 4096
      },
      "privacy": "offline",
      "recommended": false
    }
  ],
  "permissions": {
    "network": [],
    "filesystem": [
      "{data_dir}/moodvoice",
      "{repo}/output"
    ],
    "devices": []
  },
  "admin_ui": {
    "kind": "tts",
    "title": "语音厂商（TTS）",
    "capabilities": [
      "open_web_ui",
      "list",
      "write_env"
    ],
    "config_source": {
      "kind": "env_file",
      "path": ".env"
    },
    "endpoints": {
      "builtin": "/api/health"
    },
    "note": "本模块自带完整 Web 管理界面；启动器只负责打开它，不代理配置、不存密钥。",
    "web_ui": {
      "path": "/",
      "label": "语音层控制台",
      "requires_running": true
    }
  },
  "signature": {
    "algo": "SHA-256 + Ed25519",
    "value": ""
  }
}
