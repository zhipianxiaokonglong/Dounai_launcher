{
  "module_id": "dounai-ui",
  "name": "总装与 UI 层 · Dounai",
  "version": "0.1.0",
  "category": "core",
  "entry": {
    "type": "command",
    "command": "dounai.exe",
    "working_dir": "Dounai",
    "env": {},
    "health": {
      "url": null,
      "timeout_ms": 3000
    }
  },
  "compat": {
    "app_version": ">=0.1.0"
  },
  "dependencies": [
    {
      "name": "WebView2 Runtime",
      "version": ">=100",
      "type": "runtime"
    }
  ],
  "model_packs": [],
  "permissions": {
    "network": [],
    "filesystem": [
      "{app_local}"
    ],
    "devices": []
  },
  "admin_ui": {
    "kind": "app",
    "title": "悬浮窗与总线",
    "capabilities": [
      "list"
    ],
    "config_source": {
      "kind": "env_file",
      "path": ".env"
    },
    "note": "总装层没有厂商概念；此处声明用于展示该模块的存在性与自身设置。"
  },
  "signature": {
    "algo": "SHA-256 + Ed25519",
    "value": ""
  }
}
