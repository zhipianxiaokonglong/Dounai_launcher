{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dounai Launcher",
  "version": "0.3.1",
  "identifier": "com.dounai.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5175",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dounai 启动器",
        "width": 1200,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600,
        "visible": false,
        "center": true,
        "resizable": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws://localhost:5175"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "bin/uv.exe": "bin/uv.exe"
    },
    "shortDescription": "Dounai 启动器",
    "longDescription": "Dounai 的安装、环境与模块管理中心。",
    "copyright": "GPL-3.0-or-later"
  }
}
